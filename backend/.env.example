# Copy to .env and fill in real values. See PRODUCT_PLAN.md §6 for what each is for.

PORT=3001
NODE_ENV=development

# Local Postgres via `docker compose up -d` at the repo root, then `npm run migrate`.
# Swap for the Deploro connection string when that infra is provisioned.
DATABASE_URL=postgres://verbis:verbis@localhost:5432/verbis

# Required for TTS + synced highlighting (ElevenLabs `with-timestamps`).
ELEVENLABS_API_KEY=

# Required for Phase 2 (book-page scan OCR). Path to a Google Cloud service
# account JSON key with Vision API access.
GOOGLE_APPLICATION_CREDENTIALS=./gcloud-credentials.json
# In a deploy environment that only supports string env vars (e.g. Deploro
# `vps set-env`, no file upload), set this instead — base64 of the same
# service account JSON key's full contents. Takes precedence when set.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Phase 4 (summarize / ask questions about a document) uses a local Ollama
# model — no API key required. Install Ollama (https://ollama.com) and pull
# a Gemma 4 variant: gemma4:31b-cloud (largest, routes through Ollama's
# cloud relay but needs no local download of the full weights) or
# gemma4:e2b / e4b (smaller, fully on-device/offline). Override below to
# match whichever you pull.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Optional: only needed if OLLAMA_BASE_URL points at ollama.com's cloud API
# directly, or a self-hosted Ollama instance behind a reverse proxy that
# requires one. A plain local `ollama serve` ignores this — leave it blank.
OLLAMA_API_KEY=

# Optional: S3-compatible object storage (e.g. Hetzner Object Storage on
# Deploro). Leave all four blank to fall back to local disk storage under
# backend/storage/ — useful for local development before that's provisioned.
S3_ENDPOINT=
S3_BUCKET=verbis
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: override the local disk fallback directory (default: ./storage).
# LOCAL_STORAGE_DIR=storage
