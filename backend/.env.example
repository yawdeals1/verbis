# Copy to .env and fill in real values. See PRODUCT_PLAN.md §6 for what each is for.

PORT=3001
NODE_ENV=development

# No direct Postgres connection — the backend talks to Deploro's per-project
# Studio REST API instead. DEPLORO_API_URL = <deploro baseUrl>/api/projects/<id>/studio
# (see `deploro db info`). DEPLORO_API_TOKEN = a project-scoped PAT:
# `deploro token create verbis-backend --read --write --project verbis`
# (needs both scopes — write-only fails on every read/list call).
DEPLORO_API_URL=
DEPLORO_API_TOKEN=

# Deploro Auth-as-a-Service for Verbis's invite-only end users (see
# backend/src/lib/deploroAuth.ts). Base URL is the Deploro worker itself —
# same host as `baseUrl` in ~/.deploro/credentials.json, not this app's own
# domain (auth is proxied server-to-server; see the file for why).
DEPLORO_AUTH_BASE_URL=
DEPLORO_AUTH_SLUG=verbis

# CORS origin for the frontend, needed so its credentialed (cookie-bearing)
# requests are accepted. Only matters in local dev where Vite and the API
# run on different ports/origins — in production nginx proxies /api/* to
# the backend same-origin (deploro.compose.yml), so this is unused there.
FRONTEND_ORIGIN=http://localhost:5173

# Secure flag on the verbis_session cookie. Defaults to true when
# NODE_ENV=production, false otherwise — only set this explicitly to
# override that default (e.g. testing a production build over plain http).
# SESSION_COOKIE_SECURE=true

# Which TTS backend generates chunk audio: `speechify` (default) or
# `elevenlabs`. Both return the same character-anchored word timings, so
# already-generated audio stays valid across a switch — only new chunks use
# the new backend.
TTS_PROVIDER=speechify

# Required when TTS_PROVIDER=speechify. Get it from
# https://platform.speechify.ai/api-keys.
SPEECHIFY_API_KEY=
# SPEECHIFY_BASE_URL=https://api.speechify.ai/v1
# simba-3.0 (default) covers the full voice catalog and streams English plus
# six European languages; simba-3.2 sounds better but is English-only and
# limited to eight curated voices.
# SPEECHIFY_MODEL=simba-3.0

# Only needed when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
# Defaults to eleven_multilingual_v2 (~$0.10/1k chars) so switching back
# reproduces previous output. eleven_flash_v2_5 is half that per character
# and supports the same with-timestamps endpoint.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Required for Phase 2 (book-page scan OCR). Path to a Google Cloud service
# account JSON key with Vision API access.
GOOGLE_APPLICATION_CREDENTIALS=./gcloud-credentials.json
# In a deploy environment that only supports string env vars (e.g. Deploro
# `vps set-env`, no file upload), set this instead — base64 of the same
# service account JSON key's full contents. Takes precedence when set.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Phase 4 (summarize / ask questions about a document). Two setups:
#
# Local dev, talking to `ollama serve` on this machine — no API key:
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=gemma4:31b-cloud   (or a fully on-device variant: e2b / e4b)
#
# Deployed (e.g. Deploro VPS) — the server can't reach your machine's
# localhost, so call Ollama's cloud API directly instead, with an API key
# from https://ollama.com:
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_MODEL=gemma4:31b-cloud
#   OLLAMA_API_KEY=<your ollama.com API key>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=

# Deploro project storage (R2) — the production backend for uploaded
# originals and generated audio. This is DEPLORO_API_URL *without* the
# trailing `/studio`: the storage routes are siblings of the Studio DB API,
# not children of it. Requires a project-admin token (reads work with any
# member token, writes 403 without admin). Set this and the S3/local
# backends below are ignored; leave it blank to fall through to them.
DEPLORO_STORAGE_URL=

# Optional: S3-compatible object storage (e.g. Hetzner Object Storage on
# Deploro). Leave all four blank to fall back to local disk storage under
# backend/storage/ — useful for local development before that's provisioned.
S3_ENDPOINT=
S3_BUCKET=verbis
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: override the local disk fallback directory (default: ./storage).
# LOCAL_STORAGE_DIR=storage
